{
  "name": "qa-testing-repo",
  "version": "1.0.0",
  "description": "Repositorio de pruebas de QA (Quality Assurance)",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha tests/unit/**/*.test.js",
    "test:integration": "mocha tests/integration/**/*.test.js",
    "test:e2e": "cypress run",
    "test:performance": "k6 run tests/performance/*.js",
    "lint": "eslint tests/ scripts/",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "keywords": [
    "qa",
    "testing",
    "automation",
    "e2e",
    "unit-testing",
    "integration-testing"
  ],
  "license": "MIT",
  "devDependencies": {
    "mocha": "^10.2.0",
    "chai": "^4.4.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "cypress": "^13.6.0"
  }
}
